# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored so secrets never get committed.

# PostgreSQL connection string used by SQLAlchemy.
DB_CONNECTION="postgresql://postgres:password@localhost:5432/prflow_db"

# GitHub Personal Access Token (classic, scope: `repo`).
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN="your_github_personal_access_token_here"

# Optional — only needed if you use the per-user GitHub OAuth login flow.
# Register an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id_here"
GITHUB_CLIENT_SECRET="your_github_client_secret_here"
GITHUB_REDIRECT_URI="http://localhost:8000/auth/github/callback"

# Frontend URLs
FRONTEND_URL="http://localhost:3001/github-callback"
CORS_ORIGIN="http://localhost:3001"

# JWT signing key. Use a long random string in production.
SECRET_KEY="your_super_secret_jwt_key_change_me_in_production"
